# Use after DNS A records for idh.asia / www.idh.asia / billing.idh.asia
# point to 187.127.107.38 with Cloudflare proxy DISABLED (grey cloud).
#   cp Caddyfile.tls Caddyfile && docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	email admin@idh.asia
	admin off
}

idh.asia, www.idh.asia {
	encode gzip
	reverse_proxy idh:3000
}

billing.idh.asia {
	encode gzip
	reverse_proxy redpen-billing:8080
}
