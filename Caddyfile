# Origin HTTP only — Cloudflare orange-cloud + SSL mode Flexible terminates TLS at CF
# and connects to this Caddy on :80. Do NOT enable Caddyfile.tls / grey-cloud LE while
# Flexible + proxied DNS is in use (would fight CF). Switch to Full (strict) only if
# you later move TLS onto Caddy and set records to DNS-only.
{
	auto_https off
	admin off
}

http://idh.asia, http://www.idh.asia {
	encode gzip
	reverse_proxy idh:3000
}

http://billing.idh.asia {
	encode gzip
	reverse_proxy redpen-billing:8080
}

# IP / default vhost for direct smoke tests
:80 {
	encode gzip
	reverse_proxy idh:3000
}
