# DNS for idh.asia / www / billing still points at Cloudflare as of deploy time.
# Keep auto_https off until A records point at 187.127.107.38 (grey-cloud / DNS only).
# After DNS cutover, replace this file with Caddyfile.tls and reload Caddy.
{
	auto_https off
	admin off
}

http://idh.asia, http://www.idh.asia {
	encode gzip
	reverse_proxy idh:3000
}

# Public billing origin used by VITE_BILLING_API_URL=https://billing.idh.asia
# (HTTP until TLS is enabled; browsers may block mixed content from HTTPS pages).
http://billing.idh.asia {
	encode gzip
	reverse_proxy redpen-billing:8080
}

# IP / default vhost for pre-DNS smoke tests
:80 {
	encode gzip
	reverse_proxy idh:3000
}
